# Firebase web config. Create a project at https://console.firebase.google.com
# then copy these values from Project Settings > General > Your apps > Web app.
# Copy this file to .env and fill in real values. .env is gitignored.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL written onto physical NFC tags, e.g. https://reclaim.app
VITE_PUBLIC_BASE_URL=http://localhost:5173
