# Firebase web config. Create a project at https://console.firebase.google.com
# then copy these values from Project Settings > General > Your apps > Web app.
# Copy this file to .env and fill in real values. .env is gitignored.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL used to build the /nfc/:tagId links written onto physical NFC
# tags. Leave unset — lib/tags.js#tagUrl falls back to window.location.origin,
# which is correct for wherever this build is actually deployed. Only set
# this to override with a different domain, e.g. a custom domain that isn't
# the Firebase Hosting URL this was built/deployed against.
# VITE_PUBLIC_BASE_URL=

# Self-serve admin signup passcode (auth/Register.jsx's optional "Admin
# passcode" field). Ships in the client bundle by design — not real access
# control, just a low-stakes convenience gate (scripts/setAdmin.js's custom
# claim is the secure path). Falls back to '111' if unset. Rotate this
# per-deployment if it ever leaks beyond its intended small pilot audience.
# VITE_ADMIN_SIGNUP_PASSCODE=
