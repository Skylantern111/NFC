rules_version = '2';

// TagBack — NFC Lost & Found security rules.
//
// PII isolation is enforced at DOCUMENT granularity, because Firestore cannot
// filter individual fields on a read. Therefore the public-safe fields and the
// owner-linking field live in SEPARATE collections:
//
//   items/{tagId}       PUBLIC  — { tagId, itemName, isLostMode, lostMessage,
//                                    rewardAmount, category?, lostSince? }.
//                                 Contains NO PII, NO ownerUid.
//                                 Anyone (a finder) may read this.
//   tagProfiles/{tagId} PUBLIC  — owner-controlled social/contact links.
//                                 Same posture as items: no PII, no ownerUid.
//   itemOwners/{tagId}  PRIVATE — { ownerUid }. Maps a tag to its owner so the
//                                 app can authorize writes. Never public.
//   users/{uid}         PRIVATE — profile, phone, prefs. Owner-only.
//
// A finder reading items/{tagId} or tagProfiles/{tagId} therefore can never
// resolve the owner's identity, phone, email, or address.
//
// tags/{tagId} is the NFC asset registry — tagId is the TagBack ID (minted
// at registration), NOT the physical chip UID. A tag doc may carry an
// optional physicalUid field when the registering device's browser actually
// exposed one; this is descriptive hardware metadata only, never a claim
// credential (see NFC_REARCHITECTURE_PLAN.md §2/§7). tags is public-read for
// status checks but contains no PII and no ownerUid.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // An admin can soft-disable an owner account (users/{uid}.disabled) —
    // see admin/Owners.jsx. No Cloud Functions/Admin SDK in this project, so
    // this can't revoke Firebase Auth sign-in itself; it cuts off every
    // owner-gated write instead, by folding into ownsTag() below.
    function isDisabledOwner(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.disabled == true;
    }

    function ownsTag(tagId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/itemOwners/$(tagId))
        && get(/databases/$(database)/documents/itemOwners/$(tagId)).data.ownerUid == request.auth.uid
        && !isDisabledOwner(request.auth.uid);
    }

    // Two ways to be admin: the real custom claim (scripts/setAdmin.js,
    // server-side only), or a self-serve `users/{uid}.isAdmin` flag set at
    // signup via a passcode (admin/AdminRegister.jsx). SYSTEM_AUDIT_PLAN.md A1: the
    // passcode is checked HERE, against meta/adminSignup (admin-only, never
    // shipped to the client), not in the browser — and users/{uid} can no
    // longer be deleted and re-created, so `isAdmin` really is fixed at
    // creation (see users/{uid} below).
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    // A tag an admin has blacklisted (admin/Inventory.jsx) — blocks the
    // public finder flow (report/chat/message) on it. Tolerant of a
    // not-yet-provisioned tagId (treated as not blacklisted, not an error).
    function isBlacklistedTag(tagId) {
      return exists(/databases/$(database)/documents/tags/$(tagId))
        && get(/databases/$(database)/documents/tags/$(tagId)).data.status == 'blacklisted';
    }

    // MAIN_FUNCTIONS_IMPROVEMENT_PLAN.md §R2.3 — a shared bound so a direct
    // SDK call (bypassing the client's <Input> constraints) can't write an
    // unbounded string. Generous limits: these are UI-displayed strings,
    // not data fields with a "correct" length.
    function withinLength(v, max) {
      return v is string && v.size() <= max;
    }

    // Only the fields a finder is allowed to see may exist on a public item doc.
    // category/lostSince are optional (owner-set convenience fields, still no PII).
    // rewardAmount/itemName/lostMessage are bounded (§R2.3) — previously only
    // enforced client-side (Items.jsx's <Input type="number" min="0">),
    // which any direct Firestore SDK call could bypass.
    function publicItemFieldsOnly() {
      let d = request.resource.data;
      return d.keys().hasOnly(
        ['tagId', 'itemName', 'isLostMode', 'lostMessage', 'rewardAmount', 'category', 'lostSince']
      )
      && (!('itemName' in d) || withinLength(d.itemName, 100))
      && (!('lostMessage' in d) || withinLength(d.lostMessage, 500))
      && (!('rewardAmount' in d) || (d.rewardAmount is number && d.rewardAmount >= 0 && d.rewardAmount <= 1000000));
    }

    // A finder session token that's been banned by an admin (see
    // admin/Moderation.jsx) can no longer file reports or send messages.
    function isBlockedToken(token) {
      return exists(/databases/$(database)/documents/blockedTokens/$(token));
    }

    // tagProfiles/{tagId}: only the owner-controlled social/contact fields
    // may exist, and every link field present must be an https:// URL (or
    // absent — all fields are optional, per NFC_REARCHITECTURE_PLAN.md §2).
    function isHttpsUrl(v) {
      return v is string && v.matches('^https://.+');
    }
    function publicProfileFieldsOnly() {
      let d = request.resource.data;
      return d.keys().hasOnly(
        ['website', 'instagram', 'facebook', 'linkedin', 'youtube', 'tiktok', 'contactUrl', 'contactEnabled', 'lostFoundEnabled',
         'landingMode', 'displayName', 'bio', 'redirectUrl', 'updatedAt', 'updatedBy', 'editorRole']
      )
      // NFC_WRITE_DATA_ADMIN_PLAN.md — the sticker only carries the TagBack
      // URL; what a tap shows is chosen here. displayName is typed in by
      // whoever edits the profile, never copied from users/{uid}.
      && (!('landingMode' in d) || d.landingMode in ['lostfound', 'profile', 'redirect'])
      && (!('displayName' in d) || withinLength(d.displayName, 60))
      && (!('bio' in d) || withinLength(d.bio, 160))
      && (!('redirectUrl' in d) || isHttpsUrl(d.redirectUrl))
      && (!('updatedAt' in d) || d.updatedAt is timestamp)
      && (!('updatedBy' in d) || d.updatedBy == request.auth.uid)
      // SYSTEM_AUDIT_PLAN.md C1: who set the content decides whether a
      // redirect is instant (admin) or goes through a "leaving TagBack"
      // page (owner) — so only a real admin may stamp 'admin'.
      && (!('editorRole' in d) || d.editorRole == 'owner' || (d.editorRole == 'admin' && isAdmin()))
      && (!('website' in d) || isHttpsUrl(d.website))
      && (!('instagram' in d) || isHttpsUrl(d.instagram))
      && (!('facebook' in d) || isHttpsUrl(d.facebook))
      && (!('linkedin' in d) || isHttpsUrl(d.linkedin))
      && (!('youtube' in d) || isHttpsUrl(d.youtube))
      && (!('tiktok' in d) || isHttpsUrl(d.tiktok))
      // §R2.1 — contactEnabled previously had no field to actually reveal.
      // contactUrl is an owner-supplied public link (e.g. a WhatsApp
      // click-to-chat URL), same https-only posture as the social links
      // above — never a raw phone/email pulled from the private
      // users/{uid} doc.
      && (!('contactUrl' in d) || isHttpsUrl(d.contactUrl));
    }

    // Self-serve admin signup: the typed passcode must match
    // meta/adminSignup.passcode (set by an admin in admin/Owners.jsx or via
    // scripts/setAdminSignupPasscode.js). No meta doc = admin signup off.
    function validAdminPasscode() {
      let meta = /databases/$(database)/documents/meta/adminSignup;
      return exists(meta)
        && get(meta).data.passcode is string
        && get(meta).data.passcode.size() >= 6
        && request.resource.data.adminPasscode == get(meta).data.passcode;
    }

    // ---- users: private to the account owner, plus admin read/moderation.
    //      An admin may read any profile (admin/Owners.jsx lookup) and may
    //      set `disabled` (soft account disable); an owner may update their
    //      own doc but never touch `disabled`/`isAdmin` on themselves.
    //
    //      SYSTEM_AUDIT_PLAN.md A1/A2: self-delete used to be allowed, so a
    //      user could delete this doc and re-create it with isAdmin: true
    //      (self-grant admin) or without `disabled` (undo an admin's
    //      disable). Create now only accepts isAdmin: true with the real
    //      passcode, never `disabled: true`, and the doc can't be deleted. ----
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid
        && (!('disabled' in request.resource.data) || request.resource.data.disabled == false)
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false || validAdminPasscode());
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['disabled', 'isAdmin']));
      allow delete: if false;
    }

    // ---- tags: NFC asset registry. tagId is the TagBack ID (the stable
    //      identifier minted at registration — see NFC_REARCHITECTURE_PLAN.md
    //      §2), NOT the physical chip UID. A physicalUid field may or may not
    //      be present depending on what the registering browser/device could
    //      actually read (§0/§4.2 of that plan) — it is optional metadata,
    //      never the document key and never a claim credential (§7).
    //      Public may read status to detect registered/blacklisted; only
    //      admins write (via console / functions). ----
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
      // Claim path: the caller may flip status registered -> claimed for the
      // exact tag they're claiming, only alongside creating itemOwners/{tagId}
      // for themselves in the SAME transaction (see dashboard/ClaimTag.jsx).
      // Mirrors the items#create claim clause below. hasOnly(['status']) also
      // keeps physicalUid/registeredBy/registeredAt/chipType immutable from
      // this (non-admin) path.
      allow update: if isSignedIn()
        && !isDisabledOwner(request.auth.uid)
        && resource.data.status == 'registered'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'claimed'
        // An unclaimed tag an admin has set to a profile/redirect is
        // company-managed content, not stock waiting for an owner — a
        // stranger holding the sticker must not be able to take it over
        // (NFC_WRITE_DATA_ADMIN_PLAN.md). Admin sets it back to 'lostfound'
        // to hand it out.
        && (!exists(/databases/$(database)/documents/tagProfiles/$(tagId))
            || get(/databases/$(database)/documents/tagProfiles/$(tagId)).data.get('landingMode', 'lostfound') == 'lostfound')
        && existsAfter(/databases/$(database)/documents/itemOwners/$(tagId))
        && getAfter(/databases/$(database)/documents/itemOwners/$(tagId)).data.ownerUid == request.auth.uid;

      // Release path: the mirror image of the claim clause above — an owner
      // may flip status claimed -> registered for a tag they currently own,
      // only alongside DELETING itemOwners/{tagId} in the SAME transaction
      // (see lib/ownerItems.js#releaseTag / MAIN_FUNCTIONS_IMPROVEMENT_PLAN.md
      // §3.2). get() (not ownsTag()) checks ownership from BEFORE the
      // transaction, since ownsTag() would already see the sibling delete;
      // existsAfter() confirms that delete actually happened in this write.
      allow update: if isSignedIn()
        && !isDisabledOwner(request.auth.uid)
        && resource.data.status == 'claimed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'registered'
        && exists(/databases/$(database)/documents/itemOwners/$(tagId))
        && get(/databases/$(database)/documents/itemOwners/$(tagId)).data.ownerUid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/itemOwners/$(tagId));

      // ---- scan log: anonymous tap counter, no finder identity captured.
      //      Public-create (any tap), owner/admin read, immutable. ----
      match /scans/{scanId} {
        // SYSTEM_AUDIT_PLAN.md A8: real tags only, server time only.
        allow create: if request.resource.data.keys().hasOnly(['timestamp', 'roughLocation', 'landingMode'])
          && request.resource.data.timestamp == request.time
          && exists(/databases/$(database)/documents/tags/$(tagId));
        // Admin read: tap counts in admin/TagContent.jsx.
        allow read: if ownsTag(tagId) || isAdmin();
        allow update, delete: if false;
      }
    }

    // ---- tagAdmin: admin-only notes about a tag (who registered it, why it
    //      was blacklisted, which status to restore). SYSTEM_AUDIT_PLAN.md A7:
    //      these used to sit on the public tags doc. ----
    match /tagAdmin/{tagId} {
      allow read, write: if isAdmin();
    }

    // ---- items: PUBLIC-SAFE. Readable by anyone. Writable only by the owner,
    //      and only with the whitelisted public fields (blocks PII injection). ----
    match /items/{tagId} {
      allow read: if true;
      // Normal path: already-owned tag, editing item fields.
      // Claim path: itemOwners/{tagId} is being created in THIS SAME
      // transaction (see dashboard/ClaimTag.jsx). get()/exists() only see
      // state from BEFORE the transaction, so ownsTag() can't observe a
      // sibling write in progress — existsAfter()/getAfter() are the
      // purpose-built functions for validating same-transaction writes.
      allow create: if publicItemFieldsOnly() && (
        ownsTag(tagId) ||
        (isSignedIn()
          && !isDisabledOwner(request.auth.uid)
          && !exists(/databases/$(database)/documents/itemOwners/$(tagId))
          && existsAfter(/databases/$(database)/documents/itemOwners/$(tagId))
          && getAfter(/databases/$(database)/documents/itemOwners/$(tagId)).data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/tags/$(tagId)).data.status == 'registered')
      );
      allow update: if ownsTag(tagId) && publicItemFieldsOnly();
      allow delete: if ownsTag(tagId);
    }

    // ---- tagProfiles: PUBLIC-SAFE tap content (landing mode, display
    //      name, social links, contact/redirect links — see
    //      dashboard/NfcSetup.jsx and admin/TagContent.jsx). Same PII posture
    //      as items: readable by anyone, field set whitelisted. Writable by
    //      the owner, and by an admin (unclaimed/company stock, or moderating
    //      a claimed tag — updatedBy records who edited last, and the owner's
    //      NfcSetup page shows when that was an admin). ----
    match /tagProfiles/{tagId} {
      allow read: if true;
      // isAdmin() first (SYSTEM_AUDIT_PLAN.md C3): a bulk batch then skips
      // the per-tag itemOwners lookup, staying under the rules' per-request
      // lookup limit.
      allow create, update: if (isAdmin() || ownsTag(tagId)) && publicProfileFieldsOnly();
      allow delete: if isAdmin() || ownsTag(tagId);
    }

    // ---- itemOwners: private tag→owner mapping. Admin read-only, for the
    //      Owners lookup page (admin/Owners.jsx) to resolve tag -> owner and
    //      list an owner's other tags — never admin-writable. ----
    match /itemOwners/{tagId} {
      // Claim flow (dashboard/ClaimTag.jsx) reads this doc BEFORE the caller
      // owns it, to check "already claimed?". Non-owner/non-admin read is
      // only safe while the doc doesn't exist yet — no data to leak — and
      // this clause self-revokes the instant a claim creates the doc.
      allow read: if ownsTag(tagId) || isAdmin() || (isSignedIn() && resource == null);
      // Claim: create allowed only if the tag is currently registered
      // (admin has provisioned it, no owner yet), the caller assigns
      // themselves as owner, AND the same write flips tags.status to
      // 'claimed' (SYSTEM_AUDIT_PLAN.md A3). Without that last check a
      // caller could create only this doc — squatting the tag while it
      // still showed as unclaimed, and slipping past the tags#update claim
      // guard on admin-managed tags.
      allow create: if isSignedIn()
        && !isDisabledOwner(request.auth.uid)
        && request.resource.data.keys().hasOnly(['ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/tags/$(tagId)).data.status == 'registered'
        && getAfter(/databases/$(database)/documents/tags/$(tagId)).data.status == 'claimed';
      // No ownership transfer by edit. Deleting is only the release
      // transaction, which must flip the tag back to 'registered' in the
      // same write (otherwise the tag would be stuck 'claimed' with no owner).
      allow update: if false;
      allow delete: if ownsTag(tagId)
        && getAfter(/databases/$(database)/documents/tags/$(tagId)).data.status == 'registered';
    }

    // ---- reports: a finder (unauthenticated) files a found report. ----
    match /reports/{reportId} {
      // Finder creates; must carry a session token and target a real tag,
      // and that token must not be admin-blocked.
      // SYSTEM_AUDIT_PLAN.md A5: exact field set, every field bounded.
      allow create: if request.resource.data.keys().hasOnly(
          ['tagId', 'finderSessionToken', 'initialMessage', 'locationNote', 'location', 'status', 'timestamp'])
        && request.resource.data.keys().hasAll(['tagId', 'finderSessionToken', 'status'])
        && request.resource.data.status == 'open'
        && withinLength(request.resource.data.finderSessionToken, 64)
        && !isBlockedToken(request.resource.data.finderSessionToken)
        && !isBlacklistedTag(request.resource.data.tagId)
        // §R2.3 — was unbounded (client-side <Textarea> only).
        && (!('initialMessage' in request.resource.data) || withinLength(request.resource.data.initialMessage, 500))
        && (!('locationNote' in request.resource.data) || request.resource.data.locationNote == null
            || withinLength(request.resource.data.locationNote, 200))
        && (!('location' in request.resource.data) || request.resource.data.location == null
            || (request.resource.data.location.keys().hasOnly(['lat', 'lng', 'accuracy'])
                && request.resource.data.location.lat is number
                && request.resource.data.location.lng is number))
        && (!('timestamp' in request.resource.data) || request.resource.data.timestamp == request.time);
      // Only the owner of the reported tag may read/resolve it. Delete:
      // releasing a tag clears its reports so the next owner can't read
      // the previous owner's finder reports (SYSTEM_AUDIT_PLAN.md A4).
      allow read, update, delete: if ownsTag(resource.data.tagId);
    }

    // ---- chats + messages: two-way anonymous channel. ----
    match /chats/{chatId} {
      // The owner of the tag, OR the finder holding the matching session token.
      function isChatParty() {
        return ownsTag(resource.data.tagId)
          || resource.data.finderSessionToken == request.resource.data.finderSessionToken;
      }
      // get: anyone holding the (random) chatId — that's how a finder
      // reaches their chat. list: only the tag's owner or an admin — a
      // public list let anyone enumerate every chat on a tag by tagId.
      allow get: if true;
      allow list: if isAdmin() || ownsTag(resource.data.tagId);
      // No ownerUid on this doc: itemOwners stays private (finder can't read
      // it to stamp one), so Messages.jsx finds "my chats" by joining against
      // the owner's own itemOwners-derived tagIds instead (see
      // lib/ownerItems.js#useOwnerChats) — same `in`-query shape already used
      // by useOwnerOpenReports, well under the 30-tag cap for a single owner.
      // SYSTEM_AUDIT_PLAN.md A5: exact field set — a finder can't pre-set
      // blocked/resolved/reviewedAt on a new chat.
      allow create: if request.resource.data.keys().hasOnly(
          ['reportId', 'tagId', 'finderSessionToken', 'createdAt', 'lastMessageAt', 'lastMessageText', 'unreadFor'])
        && request.resource.data.keys().hasAll(['tagId', 'finderSessionToken'])
        && withinLength(request.resource.data.finderSessionToken, 64)
        && (!('lastMessageText' in request.resource.data) || withinLength(request.resource.data.lastMessageText, 140))
        && (!('unreadFor' in request.resource.data) || request.resource.data.unreadFor == ['owner'])
        && !isBlockedToken(request.resource.data.finderSessionToken)
        && !isBlacklistedTag(request.resource.data.tagId);
      // Owner may update anything on the chat (block, etc). A finder sending
      // a message only needs to touch the lightweight activity markers, or —
      // MAIN_FUNCTIONS_IMPROVEMENT_PLAN.md §5.1 — report the owner the same
      // way an owner can report a finder. An admin may only stamp their
      // review of an already-reported chat (see admin/Moderation.jsx's "mark
      // reviewed") — nothing else.
      //
      // The finder branches below inherit the same known weakness already
      // documented for isChatParty()/finder identity elsewhere (Moderation.jsx,
      // lib/finderSession.js): finderSessionToken is stored on this
      // publicly-readable chat doc, so it isn't a real secret against anyone
      // who already has the chatId. The backstop is admin review afterward,
      // not this check — consistent with this project's existing, documented
      // risk tolerance for the finder-identity model.
      //
      // SYSTEM_AUDIT_PLAN.md A6: the finder branch no longer covers
      // lastMessageText (anyone with the chatId could rewrite the preview
      // the owner sees) — the owner's list reads the real latest message
      // instead. B6: a finder report lives in its own `reportedByFinder`
      // field, so it can't overwrite (or be blocked by) the owner's.
      allow update: if ownsTag(resource.data.tagId)
        || (isChatParty()
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['lastMessageAt', 'unreadFor'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageAt'])
                || request.resource.data.lastMessageAt == request.time)
            && request.resource.data.unreadFor is list
            && request.resource.data.unreadFor.size() <= 2)
        || (isChatParty() && !ownsTag(resource.data.tagId)
            && !('reportedByFinder' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['blocked', 'reportedByFinder'])
            && request.resource.data.blocked == true
            && request.resource.data.reportedByFinder.keys().hasOnly(['reason', 'at'])
            && (request.resource.data.reportedByFinder.reason == null
                || withinLength(request.resource.data.reportedByFinder.reason, 500))
            && request.resource.data.reportedByFinder.at == request.time)
        || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reviewedAt', 'reviewedBy']));
      allow delete: if ownsTag(resource.data.tagId);

      match /messages/{messageId} {
        allow read: if true;
        // Sender must be 'owner' (and own the tag) or 'finder' (with a
        // matching, non-blocked token, on a non-blacklisted tag). Repeated
        // get()s of the same chats/{chatId} path below are served from
        // Firestore's per-request rules cache, not re-fetched.
        allow create: if request.resource.data.sender in ['owner', 'finder']
          // §R2.3 — was unbounded (client-side <Input> only).
          && withinLength(request.resource.data.text, 1000)
          && (
            (request.resource.data.sender == 'owner'
              && ownsTag(get(/databases/$(database)/documents/chats/$(chatId)).data.tagId))
            || (request.resource.data.sender == 'finder'
              && request.resource.data.finderSessionToken ==
                 get(/databases/$(database)/documents/chats/$(chatId)).data.finderSessionToken
              && !isBlockedToken(request.resource.data.finderSessionToken)
              && !isBlacklistedTag(get(/databases/$(database)/documents/chats/$(chatId)).data.tagId))
          );
        allow update, delete: if false; // messages are immutable
      }
    }

    // ---- notifications: per-owner alert feed. Written by whoever triggers
    //      the event (a finder filing a report, or a finder sending a
    //      message) — shaped exactly like `reports`: tagId-keyed, not
    //      ownerUid-keyed, since the finder writing one has no way to read
    //      the private itemOwners map to learn the owner's uid. The owner
    //      reads their own feed with the same tagId `in` join used for chats
    //      and open reports (see lib/ownerItems.js#useOwnerNotifications). ----
    match /notifications/{notifId} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'tagId', 'chatId', 'reportId', 'createdAt', 'read'])
        && request.resource.data.keys().hasAll(['type', 'tagId', 'createdAt', 'read'])
        && request.resource.data.type in ['report', 'message', 'moderation_resolved']
        && request.resource.data.createdAt == request.time
        && request.resource.data.read == false
        && exists(/databases/$(database)/documents/items/$(request.resource.data.tagId));
      allow read, update, delete: if ownsTag(resource.data.tagId);
    }

    // ---- blockedTokens: admin-managed finder ban list (see admin/Moderation.jsx). ----
    match /blockedTokens/{token} {
      allow read, write: if isAdmin();
    }

    // ---- meta: small admin-only counters/singletons (currently unused by
    //      the NFC registration flow — tagId is minted client-side per
    //      NFC_REARCHITECTURE_PLAN.md §2.2, no shared counter needed). Kept
    //      as a general admin-only bucket for any future singleton doc. ----
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
