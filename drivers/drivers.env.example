# Copy to drivers/.env.drivers (git-ignored) and fill in. Never commit real
# passwords. Only needed for live mode; preview mode needs none of this.

# preview (default, safe: mock data, no sign-in) | live (real deployment)
DRIVER_MODE=live

# Where the app runs in live mode, e.g. a local `npm run dev` with real
# Firebase config, or the deployed site.
BASE_URL=http://localhost:5173

# Normal owner account — used ONLY by user-driver.js.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# Or, with no owner account: sign up a temporary one and delete it at the end.
# DRIVER_CREATE_TEMP_USER=1

# Admin account (verified passcode admin or custom-claim admin) — used ONLY
# by admin-driver.js. Must be a different account from the owner.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Writes (claim, rename, Lost Mode, recovery, release, blacklist) are OFF
# unless BOTH are set, and then only ever touch TEST_TAG_ID — a registered
# tag kept for testing. There is no staging project: live mode writes to
# production data.
DRIVER_ALLOW_WRITES=0
TEST_TAG_ID=

# Optional
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# DRIVER_HEADLESS=0            # show the browser window
# DRIVER_PAGE_TIMEOUT_MS=20000
# DRIVER_STEP_TIMEOUT_MS=10000
